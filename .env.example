NODE_ENV=development
PORT=4000
# jwt = real bearer tokens, and the default if this is left unset.
# dev = trust x-actor-id / x-actor-role headers with no token. Local development only: it is
# refused in production and refused whenever DATABASE_URL is set.
AUTH_MODE=dev
SEED_DEMO_DATA=true
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=
DATA_ENCRYPTION_KEY=
